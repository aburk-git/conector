generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Administradores del panel de CONECTOR (no son usuarios de ningun barrio)
model AdminUsuario {
  id_admin       Int      @id @default(autoincrement())
  nombre         String
  email          String   @unique
  password_hash  String
  fecha_creacion DateTime @default(now())

  @@map("admin_usuario")
}

// Cada barrio es una instalacion independiente, con su propia base y su propia url
model Barrio {
  id_barrio      Int             @id @default(autoincrement())
  nombre         String
  subdominio     String          @unique
  url            String
  // Secreto propio de este barrio: su backend lo usa para avisar altas/bajas
  // de DNI aca, y nosotros lo usamos para pedirle el export inicial. Que sea
  // por barrio (no uno global) evita que uno pueda leer/escribir los datos de
  // otro si se filtra.
  api_key        String          @unique
  activo         Boolean         @default(true)
  fecha_creacion DateTime        @default(now())
  asociaciones   UsuarioBarrio[]

  @@map("barrio")
}

// Comprobante de "este DNI ya puso su contraseña bien en un barrio", para
// que la app pueda entrar sola a los demas barrios de ese DNI sin pedirsela
// de nuevo. Vida corta (unos minutos): lo emite el barrio de origen despues
// de validar la contraseña, y lo consume cada barrio destino una sola vez
// (ver ComprobanteSsoUso). El jti tambien va firmado adentro del JWT: la
// fila sirve para poder invalidarlo (anti-replay), no para la firma en si.
model ComprobanteSso {
  jti            String              @id
  dni            String
  id_barrio_origen Int
  expira         DateTime
  fecha_creacion DateTime            @default(now())
  usos           ComprobanteSsoUso[]

  @@index([dni])
  @@map("comprobante_sso")
}

// Un barrio destino solo puede canjear el mismo comprobante una vez (evita
// que alguien lo reuse contra el mismo barrio en loop dentro de la ventana
// de validez); distintos barrios SI pueden canjear el mismo comprobante cada
// uno la suya, porque el objetivo es entrar a todos de una.
model ComprobanteSsoUso {
  id           Int            @id @default(autoincrement())
  jti          String
  id_barrio    Int
  fecha_canje  DateTime       @default(now())
  comprobante  ComprobanteSso @relation(fields: [jti], references: [jti])

  @@unique([jti, id_barrio])
  @@map("comprobante_sso_uso")
}

// Relacion DNI <-> barrio: en que barrios tiene usuario esa persona
model UsuarioBarrio {
  id             Int      @id @default(autoincrement())
  dni            String
  nombre         String?
  apellido       String?
  // Refleja el estado del usuario en el barrio (activo/inactivo/archivado).
  // Se mantiene el registro en vez de borrarlo para que quede visible en el
  // panel quien tuvo acceso y ya no; /buscar solo devuelve activo=true, asi
  // que alguien dado de baja deja de aparecer en la app igual.
  activo         Boolean  @default(true)
  id_barrio      Int
  barrio         Barrio   @relation(fields: [id_barrio], references: [id_barrio])
  fecha_creacion DateTime @default(now())

  @@unique([dni, id_barrio])
  @@index([dni])
  @@map("usuario_barrio")
}
