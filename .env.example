DATABASE_URL="postgresql://usuario:password@localhost:5432/conector_debarrios"
JWT_SECRET="cambiar-por-un-secreto-largo-y-random"
# Secreto propio para firmar los comprobantes de SSO entre barrios (login en
# un barrio -> entra solo a los demas del mismo DNI). Distinto de JWT_SECRET:
# ese protege sesiones del panel de admin, este protege un canal de confianza
# entre barrios; mezclarlos seria mal patron aunque hoy no haya ataque conocido.
SSO_JWT_SECRET="cambiar-por-otro-secreto-largo-y-random-distinto-del-de-arriba"
FRONTEND_URL="http://localhost:5174"
PORT=4000
